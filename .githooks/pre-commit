#!/bin/sh
# Mirrors CI (lint + tsc + test) and adds the fmt check CI lacks.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx|json|less|md)$' || true)
if [ -n "$files" ]; then
  echo "$files" | xargs npx prettier --check --ignore-unknown
fi

npm run lint
npx tsc --noEmit
npm test
